      <ex:NamedEntity rdf:about="http://petclinic.semantic.graph#JCache">
        <rdfs:label>JCache</rdfs:label>
      </ex:NamedEntity>
    </ex:mentionsEntity>
    <ex:mentionsEntity>
      <ex:NamedEntity rdf:about="http://petclinic.semantic.graph#API">
