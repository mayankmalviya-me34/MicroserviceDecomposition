    <ex:hasCRUDIntent rdf:resource="http://petclinic.semantic.graph#CREATE"/>
    <ex:hasCRUDIntent rdf:resource="http://petclinic.semantic.graph#UPDATE"/>
    <ex:mentionsEntity>
      <ex:NamedEntity rdf:about="http://petclinic.semantic.graph#the_JCache_API">
        <rdfs:label>the JCache API</rdfs:label>
      </ex:NamedEntity>
