  <ex:Function rdf:about="http://petclinic.semantic.graph#___src_main_org_springframework_samples_petclinic_system_WebConfiguration_internationalization">
    <rdfs:label>...src.main.org.springframework.samples.petclinic.system.WebConfiguration.internationalization</rdfs:label>
    <ex:hasComment><![CDATA[* * Configures internationalization (i18n) support for the application. * * <p> * Handles loading language-specific messages, tracking the user's language, and allowing * language changes via the URL parameter (e.g., <code>?lang=de</code>). * </p> * * @author Anuj Ashok Potdar]]></ex:hasComment>
    <ex:hasComment>* * Uses session storage to remember the user’s language setting across requests. * Defaults to English if nothing is specified. * @return session-based {@link LocaleResolver}</ex:hasComment>
    <ex:hasComment><![CDATA[* * Allows the app to switch languages using a URL parameter like * <code>?lang=es</code>. * @return a {@link LocaleChangeInterceptor} that handles the change]]></ex:hasComment>
    <ex:hasComment>* * Registers the locale change interceptor so it can run on each request. * @param registry where interceptors are added</ex:hasComment>
    <ex:hasDomainConcept>
      <ex:DomainConcept rdf:about="http://petclinic.semantic.graph#Configures">
        <rdfs:label>Configures</rdfs:label>
      </ex:DomainConcept>
    </ex:hasDomainConcept>
    <ex:hasDomainConcept>
      <ex:DomainConcept rdf:about="http://petclinic.semantic.graph#use">
        <rdfs:label>use</rdfs:label>
      </ex:DomainConcept>
    </ex:hasDomainConcept>
    <ex:hasDomainConcept>
      <ex:DomainConcept rdf:about="http://petclinic.semantic.graph#app">
        <rdfs:label>app</rdfs:label>
      </ex:DomainConcept>
    </ex:hasDomainConcept>
    <ex:hasDomainConcept>
      <ex:DomainConcept rdf:about="http://petclinic.semantic.graph#register">
        <rdfs:label>register</rdfs:label>
      </ex:DomainConcept>
    </ex:hasDomainConcept>
    <ex:hasBusinessRole rdf:resource="http://petclinic.semantic.graph#UNKNOWN"/>
    <ex:mentionsEntity rdf:resource="http://petclinic.semantic.graph#Anuj_Ashok_Potdar"/>
    <ex:mentionsEntity>
      <ex:NamedEntity rdf:about="http://petclinic.semantic.graph#English">
        <rdfs:label>English</rdfs:label>
      </ex:NamedEntity>
    </ex:mentionsEntity>
