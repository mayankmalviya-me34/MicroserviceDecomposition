    <ex:hasCRUDIntent rdf:resource="http://petclinic.semantic.graph#READ"/>
    <ex:hasCRUDIntent>
      <ex:CRUDIntent rdf:about="http://petclinic.semantic.graph#UPDATE">
        <rdfs:label>UPDATE</rdfs:label>
