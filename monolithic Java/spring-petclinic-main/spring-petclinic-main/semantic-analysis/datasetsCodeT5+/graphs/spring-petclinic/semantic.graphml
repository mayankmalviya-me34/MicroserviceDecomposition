	public static final void syncI18nProperties() throws IOException {
		String root = Paths.get("src/main");
		String properties = Paths.get(I18N_DIR + "/" + BASE_NAME + "/" + PROPERTIES);

		try (Stream&lt;String&gt; stream = Files.walk(root)) {
			try (Stream&lt;String&gt; stream = Files.open(properties)) {
				properties = stream.read();
				properties = properties.replace("\\n", "\n");
				properties = properties.replace("\\r", "\r");
				properties = properties.replace("\\t", "\t");
				properties = properties.replace("\\b", "\b");
				properties = properties.replace("\\f",</data>
