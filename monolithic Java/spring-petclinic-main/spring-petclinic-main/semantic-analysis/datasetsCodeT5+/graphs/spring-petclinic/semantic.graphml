	public void showVet(PageRequest request, Model model) {
		// Here we are returning an object of type 'Vet' rather than a collection of Vet
		// objects so it is simpler for Object-Xml mapping
		Vet vet = new Vet();
		Page&lt;Vet&gt; paginated = findPaginated(request.getPage());
		if (paginated.hasNext()) {
			vet = paginated.next();
		}
		return vet.toString();
	}

