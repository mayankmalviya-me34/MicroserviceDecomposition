class VisitControllerTest(WebMvcTest):

    @classmethod
    def setUpClass(cls):
        super(VisitControllerTest, cls).setUpClass();

    @classmethod
    def tearDownClass(cls):
        super(VisitControllerTest, cls).tearDownClass();

    @before_each('Test')
    def before_each(self, test):
        test.assertTrue(test.get_context().is_aot_enabled(), "AOT is not enabled");

    @given('a mockito bean')
    def given_a_mockito_bean(self, mockito_bean):
        self.mockito_bean = mockito_bean;

    @given('a mockito bean')
    def given_a_mockito_bean_with_aot(self, mockito_bean):
        self.mockito_bean = mockito_bean;
        self.mockito_bean.set_aot_enabled(False);

    @given('a mockito bean')
    def</data>
