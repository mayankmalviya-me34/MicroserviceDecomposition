		}

	@Test
	void testFindWithFilter() {
		vets.findWithFilter("pet", "dog");
		vets.findWithFilter("pet", "dog"); // served vets
		}

	@Test
	void testFindWithFilterAndFilter() {
		vets.findWithFilterAndFilter("pet", "dog", "cat");
		vets.findWithFilterAndFilter("pet", "dog", "cat"); // served vets
		}

	@Test
	void testFindWithFilterAndFilterAndFilter() {
		vets.findWithFilterAndFilterAndFilter("pet", "dog", "cat", "dog");
		vets.findWithFilterAndFilterAndFilter("pet", "dog", "cat", "cat"); // served vets
