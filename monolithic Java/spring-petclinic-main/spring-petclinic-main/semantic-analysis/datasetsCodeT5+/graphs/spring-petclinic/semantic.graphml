  <data key="d0">summary</data>
  <data key="d1">
/**
 * PetClinic Spring Boot Application.
 *
 * @author Dave Syer
 */
@Configuration
public class PetClinicTestApplication {

	@ServiceConnection
	@Profile("petclinic")
	@Bean
	static MySQLContainer&lt;?&gt; container() {
		return new MySQLContainer&lt;&gt;(DockerImageName.parse("petclinic:9.2"));
	}

	public static void main(String[] args) {
		SpringApplication.run(PetClinicTestApplication.class, "--spring.profiles.active=petclinic",
				"--spring.docker.compose.enabled=false");
	}

}
</data>
</node>
