	private PetOneToMany;

	@FetchType(name = "type")
	private PetType type;

	@OrderBy(name = "birth_date")
	private Date birthDate;

	public static void save(Pet pet) {
		pet.birthDate = pet.birthDate.toString();
		pet.type = pet.type.toString();
	}
}
