<node id="../src\main\java\org\springframework\samples\petclinic\model\BaseEntity.java::summary">
  <data key="d0">summary</data>
  <data key="d1">class BaseEntity(java.io.Serializable):

	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY)
	def getId(self):
		return self.id;

	@Id.setter
	def setId(self, id):
		self.id = id;

	@Id.deleter
	def setId(self):
		self.id = None;

	@newId.setter
	def newId(self, id):
		self.id = id;

	@newId.deleter
	def newId(self):
		self.id = None;

	@newId.setter
	def isNew(self):
		return self.id == None;

	@newId.deleter
	def isNew(self):
		return self.id == None;
</data>
</node>
