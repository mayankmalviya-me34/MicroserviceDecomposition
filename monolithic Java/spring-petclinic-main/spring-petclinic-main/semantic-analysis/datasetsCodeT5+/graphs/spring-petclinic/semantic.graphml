	 */
	public void handleRequest(WebRequest request) {
		this.validateRequest(request);
		this.bindData(request);
		this.bindModel(request);
		this.bindPath(request);
		this.bindPost(request);
	}

	/**
	 * @author Juergen Hoeller
	 */
	public void validateRequest(WebRequest request) {
		if (request.getRequestHeader("Content-Type") == "application/json") {
			this.validateJSON(request);
		}
	}

	/**
	 * @author Juergen Hoeller
	 */
	public void validateJSON(WebRequest request) {
		if (request.getRequestHeader("Content-Type") == "application/json") {
			this.validateJSON(request.getBody());
		}
	}

